/dist/
/bin/
*.test
*.out
coverage.*
.DS_Store
# Never commit real app data or captures
/testdata/private/
*.ldb
*.log
# ...but generated or hand-written test fixtures under testdata/ are kept
# (the private PII deny-list stays ignored by /testdata/private/ above).
!internal/**/testdata/**/*.ldb
!internal/**/testdata/**/*.log
# rapid writes property-test failfiles here when a property fails; never commit them
**/testdata/rapid/
