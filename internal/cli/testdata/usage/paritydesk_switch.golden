usage: paritydesk switch [<alias>|-] [flags]

Switch to another profile

flags:
  --accept-worktree-risk       switch even if a worktree with uncommitted changes loses its registration
  --allow-deletions int        allow up to N deletions per category past the breaker
  --confirm-first-sync         confirm the first-sync union that the confirmed plan showed
  --confirmed-plan string      hash of the plan you confirmed (printed by paritydesk plan --json)
  --detach                     run as a detached launchd job
  --json-progress              NDJSON progress on stderr
  --no-launch                  do not relaunch Claude
  --no-reopen                  do not reopen the invoking session
  --only string                categories to carry, comma-separated: sessions,environments,order,sidebar,pins,prefs,worktrees,scratch,window,mcp
  --reopen-session string      Claude Code session id of the invoking session (set by the plugin; empty: no reopen)
  --skip string                categories to leave alone, comma-separated
  --yes                        do not ask (destructive differences after the preview still ask)

global flags:
  --app-support-dir string     paritydesk support directory
  --ascii                      ASCII only
  --config string              config file (also PARITYDESK_CONFIG)
  --json                       print one JSON document
  --lang string                message language: auto, en or ja (also PARITYDESK_LANG)
  --no-color                   no colour (also NO_COLOR, TERM=dumb)
  --plain                      plain lines, no tables or spinners
  --read-only                  plan only; never write (also PARITYDESK_READONLY=1)
  --state-dir string           state directory (also PARITYDESK_STATE_DIR)
