usage: paritydesk artifacts allow [<id>] [flags]

Decide about one artifact (Terminal only)

flags:
  --capabilities               sync it although it declares capabilities
  --create                     create it on a profile although the title is taken there
  --profile string             profile alias (default: the active profile)
  --public                     publish to public copies (implies --shared)
  --rehome                     stop tracking a copy in an organization the profile no longer uses
  --restore                    create it again on a profile where it was deleted
  --resume                     sync a skipped or ignored artifact again
  --roundtrip                  allow publishing again after a page read back differently
  --shared                     publish to copies shared with other people
  --yes                        do not ask

global flags:
  --app-support-dir string     paritydesk support directory
  --ascii                      ASCII only
  --config string              config file (also PARITYDESK_CONFIG)
  --json                       print one JSON document
  --no-color                   no colour (also NO_COLOR, TERM=dumb)
  --plain                      plain lines, no tables or spinners
  --read-only                  plan only; never write (also PARITYDESK_READONLY=1)
  --state-dir string           state directory (also PARITYDESK_STATE_DIR)
