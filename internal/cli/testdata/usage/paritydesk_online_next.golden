usage: paritydesk online next [flags]

Internal: the next calls to make (used by /paritydesk:reconcile)

flags:
  --session string             the Claude Code session running this command
  --token string               the token of the first online next answer
  --unavailable string         tools the session could not load, comma-separated
  --wait                       wait until the next calls can be made (at most 60 s)

global flags:
  --app-support-dir string     paritydesk support directory
  --ascii                      ASCII only
  --config string              config file (also PARITYDESK_CONFIG)
  --json                       print one JSON document
  --no-color                   no colour (also NO_COLOR, TERM=dumb)
  --plain                      plain lines, no tables or spinners
  --read-only                  plan only; never write (also PARITYDESK_READONLY=1)
  --state-dir string           state directory (also PARITYDESK_STATE_DIR)
