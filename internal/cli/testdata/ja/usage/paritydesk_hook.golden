usage: paritydesk hook <event>

Internal: entry point of the plugin's hooks

commands:
  post-tool-use PostToolUse hook
  pre-tool-use  PreToolUse hook
  session-start SessionStart hook

global flags:
  --app-support-dir string     paritydesk support directory
  --ascii                      ASCII only
  --config string              config file (also PARITYDESK_CONFIG)
  --json                       print one JSON document
  --lang string                message language: auto, en or ja (also PARITYDESK_LANG)
  --no-color                   no colour (also NO_COLOR, TERM=dumb)
  --plain                      plain lines, no tables or spinners
  --read-only                  plan only; never write (also PARITYDESK_READONLY=1)
  --state-dir string           state directory (also PARITYDESK_STATE_DIR)
