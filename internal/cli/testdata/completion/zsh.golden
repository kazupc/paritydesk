#compdef paritydesk
# zsh completion for paritydesk.
# Generated by "paritydesk completion zsh" from the command table; do not edit.
# Load it with: source <(paritydesk completion zsh)
# or save it as _paritydesk in a directory on $fpath.

_paritydesk_subs() {
  case $1 in
    ('') reply=('backups:Prune or purge backup generations' 'completion:Print a shell completion script' 'config:Show, locate or validate the config file' 'doctor:Check the installation, folders and app compatibility' 'generations:List or show backup generations' 'help:Show help for a command' 'history:List past runs' 'init:Set up paritydesk for the account in the app now' 'log:Show the log of a run' 'plan:Preview what a switch would change (approximate)' 'profile:Manage profiles' 'rebase:Forget every sync base; the next run is a first sync' 'recover:Finish or undo an interrupted run' 'rollback:Restore a generation without overwriting newer work' 'status:Show the active profile and anything pending' 'switch:Switch to another profile' 'sync:Re-apply the shared state to the active profile' 'uninstall:Remove paritydesk'\''s state; every data folder is kept' 'verify:Check that the app kept what the last run wrote' 'version:Print the version') ;;
    ('backups') reply=('prune:Apply the retention policy' 'purge:Remove every generation') ;;
    ('config') reply=('path:Print the config file path' 'show:Print the effective config' 'validate:Validate the config file') ;;
    ('generations') reply=('list:List generations' 'show:Show one generation') ;;
    ('profile') reply=('add:Add an account without signing out of any other' 'adopt:Register a parked folder after checking its identity' 'list:List profiles' 'remove:Unregister a profile; its folder is kept' 'rename:Rename a profile') ;;
    (*) reply=() ;;
  esac
}

_paritydesk_flags() {
  case $1 in
    ('backups purge') reply=('--yes:do not ask') ;;
    ('doctor') reply=('--bundle:write a redacted support archive (tar.gz) to this new file' '--bundle-logs:newest run logs to put in the archive' '--grant-automation:ask macOS for Automation permission now') ;;
    ('init') reply=('--alias:alias for the account in Claude now (asked when missing)' '--label:display label for the profile' '--managed:the account is managed by an employer or client' '--unmanaged:the account is not managed by an employer or client') ;;
    ('log') reply=('--run:run id (default: the last run)') ;;
    ('plan') reply=('--only:categories to carry, comma-separated: sessions,environments,order,sidebar,pins,prefs,worktrees,window,mcp' '--skip:categories to leave alone, comma-separated') ;;
    ('profile add') reply=('--managed:the account is managed by an employer or client' '--unmanaged:the account is not managed by an employer or client') ;;
    ('profile adopt') reply=('--managed:the account is managed by an employer or client' '--unmanaged:the account is not managed by an employer or client') ;;
    ('recover') reply=('--rollback:undo the interrupted run instead of completing it' '--yes:do not ask') ;;
    ('rollback') reply=('--propagate:carry the restored values to other profiles on the next switch' '--yes:do not ask') ;;
    ('status') reply=('--short:one line; never opens Local Storage') ;;
    ('switch') reply=('--accept-worktree-risk:switch even if a worktree with uncommitted changes loses its registration' '--allow-deletions:allow up to N deletions per category past the breaker' '--confirm-first-sync:confirm the first-sync union that the confirmed plan showed' '--confirmed-plan:hash of the plan you confirmed (printed by paritydesk plan --json)' '--detach:run as a detached launchd job' '--json-progress:NDJSON progress on stderr' '--no-launch:do not relaunch Claude' '--no-reopen:do not reopen the invoking session' '--only:categories to carry, comma-separated: sessions,environments,order,sidebar,pins,prefs,worktrees,window,mcp' '--reopen-session:Claude Code session id of the invoking session (set by the plugin; empty: no reopen)' '--skip:categories to leave alone, comma-separated' '--yes:do not ask (destructive differences after the preview still ask)') ;;
    ('sync') reply=('--allow-deletions:allow up to N deletions per category past the breaker' '--json-progress:NDJSON progress on stderr' '--no-launch:do not relaunch Claude' '--yes:do not ask') ;;
    ('uninstall') reply=('--keep-backups:keep backup generations' '--keep-state:keep the state directory as well' '--yes:do not ask') ;;
    (*) reply=() ;;
  esac
  reply+=('--app-support-dir:paritydesk support directory' '--ascii:ASCII only' '--config:config file (also PARITYDESK_CONFIG)' '--json:print one JSON document' '--no-color:no colour (also NO_COLOR, TERM=dumb)' '--plain:plain lines, no tables or spinners' '--read-only:plan only; never write (also PARITYDESK_READONLY=1)' '--state-dir:state directory (also PARITYDESK_STATE_DIR)')
}

_paritydesk_value_flags() {
  case $1 in
    ('doctor') reply=(--bundle --bundle-logs) ;;
    ('init') reply=(--alias --label) ;;
    ('log') reply=(--run) ;;
    ('plan') reply=(--only --skip) ;;
    ('switch') reply=(--allow-deletions --confirmed-plan --only --reopen-session --skip) ;;
    ('sync') reply=(--allow-deletions) ;;
    (*) reply=() ;;
  esac
  reply+=(--app-support-dir --config --state-dir)
}

_paritydesk_args() {
  case $1 in
    ('plan'|'profile remove'|'profile rename'|'switch')) REPLY=alias ;;
    ('help')) REPLY=command ;;
    ('completion')) REPLY=shell ;;
    (*) REPLY='' ;;
  esac
}

_paritydesk() {
  local cur=${words[CURRENT]} prev=${words[CURRENT-1]} cmdpath='' word flag REPLY
  local -a reply aliases
  local -i i=2
  while (( i < CURRENT )); do
    word=${words[i]}
    case $word in
      (--) break ;;
      (-*=*) ;;
      (-*)
        flag=$word
        [[ $flag == --* ]] || flag=-$flag
        _paritydesk_value_flags "$cmdpath"
        if (( ${reply[(Ie)$flag]} )); then
          (( i++ ))
        fi
        ;;
      (*)
        _paritydesk_subs "$cmdpath"
        if (( ${reply[(I)${(b)word}:*]} )); then
          cmdpath=${cmdpath:+$cmdpath }$word
        fi
        ;;
    esac
    (( i++ ))
  done

  if [[ $prev == -* ]]; then
    flag=$prev
    [[ $flag == --* ]] || flag=-$flag
    _paritydesk_value_flags "$cmdpath"
    if (( ${reply[(Ie)$flag]} )); then
      case $flag in
        (--bundle|--config) _files ;;
        (--app-support-dir|--state-dir) _files -/ ;;
        (--only|--skip) compset -P '*,'; compadd -- sessions environments order sidebar pins prefs worktrees window mcp ;;
      esac
      return
    fi
  fi

  if [[ $cur == -* ]]; then
    _paritydesk_flags "$cmdpath"
    _describe -t flags 'flag' reply
    return
  fi
  _paritydesk_subs "$cmdpath"
  if (( $#reply )); then
    _describe -t commands 'command' reply
    return
  fi
  _paritydesk_args "$cmdpath"
  case $REPLY in
    (alias) aliases=(${(f)"$(command paritydesk __aliases 2>/dev/null)"}); compadd -- $aliases ;;
    (command) _paritydesk_subs ''; _describe -t commands 'command' reply ;;
    (shell) compadd -- bash fish zsh ;;
  esac
}

if [[ $funcstack[1] == _paritydesk ]]; then
  _paritydesk "$@"
else
  compdef _paritydesk paritydesk
fi
