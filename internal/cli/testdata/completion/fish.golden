# fish completion for paritydesk.
# Generated by "paritydesk completion fish" from the command table; do not edit.
# Load it with: paritydesk completion fish | source

function __paritydesk_subs
    switch "$argv[1]"
        case ''
            printf '%s\n' backups completion config doctor generations help history init log plan profile rebase recover rollback status switch sync uninstall verify version
        case 'backups'
            printf '%s\n' prune purge
        case 'config'
            printf '%s\n' path show validate
        case 'generations'
            printf '%s\n' list show
        case 'profile'
            printf '%s\n' add adopt list remove rename
    end
end

function __paritydesk_value_flags
    switch "$argv[1]"
        case 'backups prune'
            printf '%s\n' --older-than
        case 'doctor'
            printf '%s\n' --bundle --bundle-logs
        case 'init'
            printf '%s\n' --alias --label
        case 'log'
            printf '%s\n' --run
        case 'plan'
            printf '%s\n' --only --skip
        case 'switch'
            printf '%s\n' --allow-deletions --confirmed-plan --only --reopen-session --skip
        case 'sync'
            printf '%s\n' --allow-deletions
    end
    printf '%s\n' --app-support-dir --config --state-dir
end

# __paritydesk_path prints the command path typed so far, such as
# "profile add".
function __paritydesk_path
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l cmdpath ''
    set -l skip 0
    for word in $tokens
        if test $skip -eq 1
            set skip 0
            continue
        end
        switch $word
            case '--'
                break
            case '-*=*'
                continue
            case '--*'
                if contains -- $word (__paritydesk_value_flags "$cmdpath")
                    set skip 1
                end
            case '-*'
                if contains -- -$word (__paritydesk_value_flags "$cmdpath")
                    set skip 1
                end
            case '*'
                if contains -- $word (__paritydesk_subs "$cmdpath")
                    set cmdpath (string trim -- "$cmdpath $word")
                end
        end
    end
    echo $cmdpath
end

function __paritydesk_at
    set -l p (__paritydesk_path)
    test "$p" = "$argv[1]"
end

# __paritydesk_categories completes one name of a comma-separated list.
function __paritydesk_categories
    set -l pre (string replace -r '[^,]*$' '' -- (commandline -ct))
    for c in sessions environments order sidebar pins prefs worktrees scratch window mcp
        echo $pre$c
    end
end

complete -c paritydesk -f

