# bash completion for paritydesk.
# Generated by "paritydesk completion bash" from the command table; do not edit.
# Load it with: source <(paritydesk completion bash)

_paritydesk_subs() {
    case "$1" in
        '') echo 'backups completion config doctor generations help history init log plan profile rebase recover rollback status switch sync uninstall verify version' ;;
        'backups') echo 'prune purge' ;;
        'config') echo 'path show validate' ;;
        'generations') echo 'list show' ;;
        'profile') echo 'add adopt list remove rename' ;;
    esac
}

_paritydesk_flags() {
    case "$1" in
        'backups purge') echo '--yes' ;;
        'doctor') echo '--bundle --bundle-logs --grant-automation' ;;
        'init') echo '--alias --label --managed --unmanaged' ;;
        'log') echo '--run' ;;
        'plan') echo '--only --skip' ;;
        'profile add') echo '--managed --unmanaged' ;;
        'profile adopt') echo '--managed --unmanaged' ;;
        'recover') echo '--rollback --yes' ;;
        'rollback') echo '--propagate --yes' ;;
        'status') echo '--short' ;;
        'switch') echo '--accept-worktree-risk --allow-deletions --confirm-first-sync --confirmed-plan --detach --json-progress --no-launch --no-reopen --only --reopen-session --skip --yes' ;;
        'sync') echo '--allow-deletions --json-progress --no-launch --yes' ;;
        'uninstall') echo '--keep-backups --keep-state --yes' ;;
    esac
    echo '--app-support-dir --ascii --config --json --no-color --plain --read-only --state-dir'
}

_paritydesk_value_flags() {
    case "$1" in
        'doctor') echo '--bundle --bundle-logs' ;;
        'init') echo '--alias --label' ;;
        'log') echo '--run' ;;
        'plan') echo '--only --skip' ;;
        'switch') echo '--allow-deletions --confirmed-plan --only --reopen-session --skip' ;;
        'sync') echo '--allow-deletions' ;;
    esac
    echo '--app-support-dir --config --state-dir'
}

_paritydesk_args() {
    case "$1" in
        'plan'|'profile remove'|'profile rename'|'switch') echo alias ;;
        'help') echo command ;;
        'completion') echo shell ;;
    esac
}

# _paritydesk_has <words> <word> succeeds when word is one of the
# space-separated words.
_paritydesk_has() {
    local w
    for w in $1; do
        [ "$w" = "$2" ] && return 0
    done
    return 1
}

# _paritydesk_long <flag> spells a flag with two dashes.
_paritydesk_long() {
    case "$1" in
        --*) echo "$1" ;;
        *) echo "-$1" ;;
    esac
}

# _paritydesk_reply adds the lines of its input to COMPREPLY.
_paritydesk_reply() {
    local line
    while IFS= read -r line; do
        COMPREPLY+=("$line")
    done
}

_paritydesk() {
    local cur prev cmdpath word i subs pre
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev=""
    if [ "$COMP_CWORD" -gt 0 ]; then
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    fi
    cmdpath=""
    i=1
    while [ "$i" -lt "$COMP_CWORD" ]; do
        word="${COMP_WORDS[i]}"
        case "$word" in
            --) break ;;
            -*=*) ;;
            -*)
                if _paritydesk_has "$(_paritydesk_value_flags "$cmdpath")" "$(_paritydesk_long "$word")"; then
                    i=$((i + 1))
                fi
                ;;
            *)
                if _paritydesk_has "$(_paritydesk_subs "$cmdpath")" "$word"; then
                    cmdpath="${cmdpath:+$cmdpath }$word"
                fi
                ;;
        esac
        i=$((i + 1))
    done

    case "$prev" in
        -*)
            if _paritydesk_has "$(_paritydesk_value_flags "$cmdpath")" "$(_paritydesk_long "$prev")"; then
                case "$(_paritydesk_long "$prev")" in
                    --bundle|--config)
                        compopt -o filenames 2>/dev/null
                        _paritydesk_reply < <(compgen -f -- "$cur") ;;
                    --app-support-dir|--state-dir)
                        compopt -o filenames 2>/dev/null
                        _paritydesk_reply < <(compgen -d -- "$cur") ;;
                    --only|--skip)
                        pre=""
                        case "$cur" in *,*) pre="${cur%,*}," ;; esac
                        _paritydesk_reply < <(compgen -W 'sessions environments order sidebar pins prefs worktrees scratch window mcp' -P "$pre" -- "${cur##*,}") ;;
                esac
                return 0
            fi
            ;;
    esac

    case "$cur" in
        -*)
            _paritydesk_reply < <(compgen -W "$(_paritydesk_flags "$cmdpath")" -- "$cur")
            return 0
            ;;
    esac
    subs="$(_paritydesk_subs "$cmdpath")"
    if [ -n "$subs" ]; then
        _paritydesk_reply < <(compgen -W "$subs" -- "$cur")
        return 0
    fi
    case "$(_paritydesk_args "$cmdpath")" in
        alias) _paritydesk_reply < <(compgen -W "$(command paritydesk __aliases 2>/dev/null)" -- "$cur") ;;
        command) _paritydesk_reply < <(compgen -W "$(_paritydesk_subs '')" -- "$cur") ;;
        shell) _paritydesk_reply < <(compgen -W 'bash fish zsh' -- "$cur") ;;
    esac
    return 0
}

complete -F _paritydesk paritydesk
